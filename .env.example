# MongoDB Connection Configuration
# Copy this file to .env and update with your actual MongoDB connection details

# MongoDB connection details
MONGDB_USERNAME=admin
MONGDB_PASSWORD=password
MONGDB_HOST=localhost
MONGDB_PORT=27017
MONGDB_DATABASE=myDb

# MongoDB Authentication Method
# Set to "true" to use AWS IAM authentication (for DocumentDB or MongoDB Atlas with AWS IAM)
# When enabled, MONGODB_USERNAME should be the AWS access key or ARN
USE_IAM_AUTH=false

# Deployment environment: "local" or "aws"
# local - uses local master key for encryption
# aws - uses AWS KMS for key management
DEPLOYMENT_ENV=local

# Use IAM authentication for AWS KMS access
# Set to "true" to use IAM roles for KMS (recommended for production)
# When true, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are not required
USE_IAM_FOR_KMS=true

# AWS KMS Configuration (required when DEPLOYMENT_ENV=aws)
AWS_REGION=us-east-1
AWS_KMS_KEY_ARN=

# AWS Credentials (optional when USE_IAM_FOR_KMS=true)
# Only provide these if not using IAM roles (e.g., local development)
# For production, use IAM roles (EC2, ECS, Lambda) instead
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
